#include <stdio.h>

int array_minmax(const int *arr, size_t n, int *out_min, int *out_max)
{
    if (arr == NULL || out_min == NULL || out_max == NULL || n == 0)
        return -1;

    *out_min = *arr;
    *out_max = *arr;

    for (size_t i = 1; i < n; i++)
    {
        if (*(arr + i) < *out_min)
            *out_min = *(arr + i);

        if (*(arr + i) > *out_max)
            *out_max = *(arr + i);
    }

    return 0;
}

int main()
{
    int arr[] = {12, -3, 8, 21, 0};
    int min, max;

    array_minmax(arr, 5, &min, &max);

    printf("Minimum = %d\n", min);
    printf("Maximum = %d\n", max);

    return 0;
}